# Client-safe Supabase configuration for Vite.
# Copy to .env.local. Never put the Secret or Service Role key here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Canonical public origin for OAuth / email redirects (no trailing slash).
# Production MUST be the public domain — never a *.vercel.app URL.
VITE_APP_ORIGIN=https://www.emedicalls.com

VITE_APPLE_SIGNIN_ENABLED=false
