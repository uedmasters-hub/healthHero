+}
+
+.ds-empty.is-card {
+  background: var(--card-bg);
+  border: var(--card-border);
+  border-radius: var(--card-radius);
+}
+
+.ds-empty.is-compact { padding: var(--space-xl) var(--space-lg); }
+
+.ds-empty__media {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  margin-bottom: var(--space-xs);
+}
+
+.ds-empty__media img {
+  width: 8.5rem;
+  height: auto;
+  max-height: 8.5rem;
+  object-fit: contain;
+}
+
+.ds-empty__title {
+  margin: 0;
+  font-size: var(--font-size-body-m);
+  line-height: 1.3;
+  font-weight: var(--font-weight-medium);
+  color: var(--pp-headline);
+}
+
+.ds-empty__copy {
+  margin: 0;
+  max-width: 18rem;
+  font-size: var(--text-label-size);
+  line-height: var(--text-body-line);
+  color: var(--text-tertiary);
+}
+
+.ds-empty__actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: var(--space-sm);
+  margin-top: var(--space-sm);
+}
+
+/* ── App bar (pushed pages) ────────────────────────────────────────────────
+   [ back ]  Title  [ actions ] — centred title, 44px controls              */
+.ds-app-bar {
+  position: relative;
+  z-index: 2;
+  flex-shrink: 0;
+  display: grid;
+  grid-template-columns: minmax(var(--touch-min), 1fr) auto minmax(var(--touch-min), 1fr);
+  align-items: center;
+  gap: var(--space-sm);
+  min-height: var(--app-bar-height);
+  padding: var(--space-1) var(--space-sm);
+  background: var(--surface-2);
+  border-bottom: var(--border-width) solid var(--border-divider);
+}
+
+.ds-app-bar.is-flush { border-bottom-color: transparent; }
+.ds-app-bar.is-canvas { background: var(--bg); }
+
+.ds-app-bar__lead { justify-self: start; display: flex; align-items: center; }
+.ds-app-bar__actions {
+  justify-self: end;
+  display: flex;
+  align-items: center;
+  gap: var(--space-xs);
+}
+
+.ds-app-bar__title {
+  min-width: 0;
+  margin: 0;
+  font-size: var(--font-size-body-m);
+  line-height: 1.25;
+  font-weight: var(--font-weight-medium);
+  color: var(--pp-headline);
+  text-align: center;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.ds-app-bar__sub {
+  display: block;
+  font-size: var(--text-caption-size);
+  font-weight: var(--font-weight-regular);
+  color: var(--text-tertiary);
+}
+
+.ds-app-bar .ds-btn--text { font-size: var(--text-label-size); }
+
+/* Large page title (tab roots) — PP PageHeader: medium 26px brand ink */
+.ds-page-title {
+  margin: 0;
+  font-size: var(--font-size-h4);
+  line-height: 1.2;
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--letter-tight);
+  color: var(--pp-headline);
+}
+
+/* ── Stack helpers (vertical rhythm inside pages) ─────────────────────── */
+.ds-stack { display: flex; flex-direction: column; gap: var(--stack-gap); }
+.ds-stack.is-tight { gap: var(--space-sm); }
+.ds-stack.is-loose { gap: var(--section-gap); }
+
+.ds-page-section + .ds-page-section { margin-top: var(--section-gap); }
+
+/* Key → value row (details, invoices) */
+.ds-kv {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--space-md);
+  font-size: var(--text-label-size);
+  line-height: var(--text-label-line);
+}
+.ds-kv__key { color: var(--text-tertiary); }
+.ds-kv__value { color: var(--text-primary); font-weight: var(--font-weight-medium); text-align: right; }
+
+/* ── Progress ─────────────────────────────────────────────────────────── */
+.ds-progress {
+  height: 0.5rem;
+  width: 100%;
+  overflow: hidden;
+  border-radius: var(--radius-full);
+  background: var(--surface-1);
+  border: var(--border-width) solid var(--border-default);
+}
+.ds-progress__bar {
+  height: 100%;
+  border-radius: inherit;
+  background: var(--primary-950);
+  transition: width var(--duration-progress) var(--ease-standard);
+}
+.ds-progress.is-wellness .ds-progress__bar { background: var(--color-wellness); }
