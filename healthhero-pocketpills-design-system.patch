+
+.ds-interact-row:active:not(:disabled):not([aria-disabled='true']) {
+  background: var(--interact-pressed-bg);
+}
+
+.ds-interact-row.is-selected,
+.ds-interact-row.is-active,
+.ds-interact-row.active,
+.ds-interact-row[aria-selected='true'],
+.ds-interact-row[aria-pressed='true'] {
+  background: var(--interact-selected-bg);
+}
+
+/* ── Chip (filter / choice) ────────────────────────────────────────────────
+   PP toggle: pill · 500 · idle white + hairline · selected = brand-ink fill */
+.ds-chip,
+.ds-interact-chip {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-1-5);
+  min-height: var(--chip-height);
+  padding: 0 var(--chip-pad-x);
+  border: var(--border-width) solid var(--border-default);
+  border-radius: var(--radius-full);
+  background: var(--surface-2);
+  color: var(--pp-headline);
+  font-family: inherit;
+  font-size: var(--chip-font);
+  font-weight: var(--font-weight-medium);
+  line-height: 1.2;
+  white-space: nowrap;
+  cursor: pointer;
+  flex-shrink: 0;
+  -webkit-tap-highlight-color: transparent;
+  transition: var(--interact-transition);
+}
+
+.ds-chip svg {
+  width: var(--icon-sm);
+  height: var(--icon-sm);
+  stroke-width: var(--icon-stroke);
+}
+
+.ds-chip--sm { min-height: var(--chip-height-sm); padding: 0 var(--space-md); font-size: var(--text-caption-size); }
+
+.ds-chip:hover:not(:disabled):not(.is-active):not(.is-selected):not([aria-pressed='true']):not([aria-selected='true']),
+.ds-interact-chip:hover:not(:disabled):not(.is-active):not(.is-selected):not([aria-pressed='true']) {
+  background: var(--state-hover);
+}
+
+.ds-chip:active:not(:disabled),
+.ds-interact-chip:active:not(:disabled) {
+  background: var(--state-pressed);
+}
+
+.ds-chip.is-active,
+.ds-chip.is-selected,
+.ds-chip[aria-pressed='true'],
+.ds-chip[aria-selected='true'],
+.ds-chip[aria-checked='true'],
+.ds-interact-chip.is-active,
+.ds-interact-chip.is-selected,
+.ds-interact-chip[aria-pressed='true'] {
+  background: var(--chip-selected-bg);
+  border-color: var(--chip-selected-bg);
+  color: var(--chip-selected-fg);
+  box-shadow: none;
+}
+
+.ds-chip:disabled {
+  opacity: var(--opacity-disabled);
+  cursor: not-allowed;
+}
+
+/* Soft variant — selected = lavender (secondary filters inside cards) */
+.ds-chip--soft.is-active,
+.ds-chip--soft.is-selected,
+.ds-chip--soft[aria-pressed='true'],
+.ds-chip--soft[aria-selected='true'] {
+  background: var(--state-selected);
+  border-color: var(--state-selected-border);
+  color: var(--pp-headline);
+}
+
+/* Horizontal chip rail — bleeds to the page gutter, snaps, no scrollbar */
+.ds-chip-row {
+  display: flex;
+  gap: var(--space-sm);
+  overflow-x: auto;
+  overscroll-behavior-x: contain;
+  scrollbar-width: none;
+  scroll-snap-type: x proximity;
+  -webkit-overflow-scrolling: touch;
+}
+.ds-chip-row::-webkit-scrollbar { display: none; }
+.ds-chip-row > * { scroll-snap-align: start; }
+.ds-chip-row.is-bleed {
+  margin-inline: calc(var(--content-padding) * -1);
+  padding-inline: var(--content-padding);
+  scroll-padding-inline: var(--content-padding);
+}
+
+/* ── Badge / status pill ───────────────────────────────────────────────── */
+.ds-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-1);
+  min-height: var(--badge-height);
+  padding: 0 var(--badge-pad-x);
+  border-radius: var(--radius-full);
+  border: var(--border-width) solid transparent;
+  background: var(--surface-1);
+  color: var(--text-secondary);
+  font-size: var(--badge-font);
+  font-weight: var(--font-weight-medium);
+  line-height: 1.2;
+  letter-spacing: var(--letter-body);
+  white-space: nowrap;
+  flex-shrink: 0;
+}
+
+.ds-badge svg { width: var(--icon-xs); height: var(--icon-xs); stroke-width: 2; }
+.ds-badge.is-neutral { background: var(--surface-1); color: var(--text-secondary); border-color: var(--border-default); }
+.ds-badge.is-primary { background: var(--primary-300); color: var(--primary-950); }
+.ds-badge.is-info { background: var(--color-info-subtle); color: var(--primary-950); }
+.ds-badge.is-success { background: var(--color-success-subtle); color: var(--success-900); }
+.ds-badge.is-warning { background: var(--color-warning-subtle); color: var(--warning-900); }
+.ds-badge.is-danger { background: var(--color-danger-subtle); color: var(--color-danger); }
+.ds-badge.is-wellness { background: var(--color-wellness-subtle); color: var(--secondary-900); }
+.ds-badge.is-processing { background: var(--color-processing-subtle); color: var(--color-processing); }
+.ds-badge.is-muted { background: var(--neutral-200); color: var(--neutral-700); }
+.ds-badge.is-solid { background: var(--primary-950); color: var(--neutral-0); }
+.ds-badge.is-glass { background: var(--featured-glass); color: var(--featured-ink); border-color: var(--featured-glass-border); }
+.ds-badge.is-ready { background: var(--badge-ready-bg); color: var(--badge-ready-fg); border-color: var(--badge-ready-border); }
+.ds-badge.is-caps {
+  font-size: var(--text-caption-size);
+  font-weight: var(--font-weight-bold);
+  letter-spacing: var(--letter-caps);
+  text-transform: uppercase;
+}
+
+/* Count dot — nav / bell */
+.ds-count {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 1.125rem;
+  height: 1.125rem;
+  padding: 0 var(--space-1);
+  border-radius: var(--radius-full);
+  background: var(--color-danger);
+  color: var(--neutral-0);
+  font-size: var(--text-badge-size);
+  font-weight: var(--font-weight-bold);
+  line-height: 1;
+  font-variant-numeric: tabular-nums;
+}
+
+/* ── Field / input ─────────────────────────────────────────────────────────
+   PP Field: h-12 · rounded-xl · hairline · white · focus → primary-600 edge */
+.ds-field {
+  display: flex;
+  align-items: center;
+  gap: var(--space-sm);
+  width: 100%;
+  min-height: var(--field-height);
+  padding: 0 var(--field-pad-x);
+  background: var(--field-bg);
+  border: var(--border-width) solid var(--border-default);
+  border-radius: var(--field-radius);
+  color: var(--text-primary);
+  font-family: inherit;
+  font-size: var(--text-body-size);
+  line-height: var(--text-title-line);
+  transition: var(--interact-transition);
+}
+
+.ds-field:hover:not(:disabled):not(:focus-within):not(.is-disabled) {
+  background: var(--state-hover);
+}
+
+.ds-field:focus-within,
+.ds-field:focus {
+  border-color: var(--primary-600);
+  background: var(--field-bg);
+}
+
+.ds-field.is-error,
+.ds-field[aria-invalid='true'] {
