+}
+
+.ds-field.is-disabled,
+.ds-field:disabled {
+  background: var(--surface-1);
+  color: var(--text-disabled);
+}
+
+/* Bare input inside a .ds-field wrapper */
+.ds-field > input,
+.ds-field > select,
+.ds-field__input {
+  flex: 1;
+  min-width: 0;
+  height: 100%;
+  min-height: calc(var(--field-height) - 2px);
+  padding: 0;
+  border: none;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+}
+
+.ds-field > svg,
+.ds-field__icon {
+  width: var(--icon-sm);
+  height: var(--icon-sm);
+  flex-shrink: 0;
+  color: var(--text-tertiary);
+  stroke-width: var(--icon-stroke);
+}
+
+textarea.ds-field,
+.ds-field.is-multiline {
+  min-height: calc(var(--field-height) * 2);
+  padding: var(--space-md) var(--field-pad-x);
+  align-items: flex-start;
+  resize: vertical;
+}
+
+.ds-field-label {
+  display: block;
+  margin: 0 0 var(--space-1-5);
+  font-size: var(--text-label-size);
+  line-height: var(--text-label-line);
+  font-weight: var(--font-weight-medium);
+  color: var(--text-secondary);
+}
+
+.ds-field-hint,
+.ds-field-error {
+  margin: var(--space-1-5) 0 0;
+  font-size: var(--text-caption-size);
+  line-height: var(--text-caption-line);
+}
+.ds-field-hint { color: var(--text-tertiary); }
+.ds-field-error { color: var(--danger); }
+
+/* Search — PP PageSearchField: pill · white · hairline · 16px glyph */
+.ds-search {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: var(--space-sm);
+  width: 100%;
+  min-height: var(--search-height);
+  padding: 0 var(--space-sm) 0 var(--space-lg);
+  background: var(--field-bg);
+  border: var(--border-width) solid var(--border-default);
+  border-radius: var(--search-radius);
+  color: var(--text-primary);
+  transition: var(--interact-transition);
+}
+.ds-search:focus-within { border-color: var(--primary-600); }
+.ds-search > svg,
+.ds-search__icon {
+  width: var(--icon-sm);
+  height: var(--icon-sm);
+  flex-shrink: 0;
+  color: var(--text-tertiary);
+  stroke-width: var(--icon-stroke);
+}
+.ds-search > input,
+.ds-search__input {
+  flex: 1;
+  min-width: 0;
+  height: calc(var(--search-height) - 2px);
+  border: none;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  font-size: var(--text-body-size);
+}
+
+/* ── Switch ───────────────────────────────────────────────────────────── */
+.ds-switch {
+  position: relative;
+  width: 3rem;
+  height: 1.75rem;
+  flex-shrink: 0;
+  border: none;
+  border-radius: var(--radius-full);
+  background: var(--toggle-off);
+  cursor: pointer;
+  transition: background-color var(--transition);
+}
+.ds-switch::after {
+  content: '';
+  position: absolute;
+  top: 0.25rem;
+  left: 0.25rem;
+  width: 1.25rem;
+  height: 1.25rem;
+  border-radius: var(--radius-full);
+  background: var(--neutral-0);
+  box-shadow: var(--shadow-xs);
+  transition: transform var(--transition);
+}
+.ds-switch[aria-checked='true'],
+.ds-switch.is-on { background: var(--primary-950); }
+.ds-switch[aria-checked='true']::after,
+.ds-switch.is-on::after { transform: translateX(1.25rem); }
+.ds-switch:disabled { opacity: var(--opacity-disabled); cursor: not-allowed; }
+
+/* ── Section head ──────────────────────────────────────────────────────────
+   PP SectionHead: optional caps eyebrow → medium title → optional action  */
+.ds-section-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--space-md);
+  margin: 0 0 var(--section-header-gap);
+}
+
+.ds-section-head__title {
+  margin: 0;
+  font-size: var(--font-size-body-m);
+  line-height: 1.25;
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--letter-tight);
+  color: var(--pp-headline);
+}
+
+.ds-section-head__sub {
+  margin: var(--space-1) 0 0;
+  font-size: var(--text-label-size);
+  line-height: var(--text-label-line);
+  color: var(--text-tertiary);
+}
+
+.ds-section-head__action {
+  flex-shrink: 0;
+}
+
+/* Caps group label (settings lists, profile groups) */
+.ds-section-title {
+  font-size: var(--text-overline-size);
+  font-weight: var(--text-overline-weight);
+  line-height: var(--text-overline-line);
+  letter-spacing: var(--text-overline-tracking);
+  text-transform: uppercase;
+  color: var(--text-tertiary);
+  margin: 0 0 var(--space-3);
+}
+
+/* ── List (grouped rows inside one card) ───────────────────────────────── */
+.ds-list {
+  display: flex;
+  flex-direction: column;
+  background: var(--card-bg);
+  border: var(--card-border);
+  border-radius: var(--card-radius);
+  overflow: hidden;
+}
+
+.ds-list-row {
+  display: flex;
+  align-items: center;
+  gap: var(--space-md);
+  width: 100%;
+  min-height: 3.5rem;
+  padding: var(--space-md) var(--card-padding);
+  background: transparent;
+  border: none;
+  color: var(--text-primary);
+  font: inherit;
+  text-align: left;
+  text-decoration: none;
+  -webkit-tap-highlight-color: transparent;
+  transition: var(--interact-transition);
+}
+
+.ds-list-row + .ds-list-row {
+  border-top: var(--border-width) solid var(--border-divider);
+}
+
+button.ds-list-row,
+a.ds-list-row,
+.ds-list-row.is-interactive { cursor: pointer; }
+button.ds-list-row:hover:not(:disabled),
+a.ds-list-row:hover,
+.ds-list-row.is-interactive:hover { background: var(--state-hover); }
+button.ds-list-row:active:not(:disabled),
+a.ds-list-row:active,
+.ds-list-row.is-interactive:active { background: var(--state-pressed); }
+
+.ds-list-row__body {
+  flex: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-0-5);
+}
+
+.ds-list-row__title {
+  font-size: var(--text-body-size);
+  line-height: var(--text-title-line);
+  font-weight: var(--font-weight-medium);
+  color: var(--text-primary);
+}
+
+.ds-list-row__sub {
+  font-size: var(--text-caption-size);
+  line-height: var(--text-caption-line);
+  color: var(--text-tertiary);
+}
+
+.ds-list-row__trail {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-sm);
+  flex-shrink: 0;
+  color: var(--text-tertiary);
+  font-size: var(--text-label-size);
+}
+
+.ds-list-row__chevron {
+  width: var(--icon-sm);
+  height: var(--icon-sm);
+  color: var(--icon-color-muted);
+  stroke-width: var(--icon-stroke);
+  flex-shrink: 0;
+}
+
+.ds-list-row.is-danger .ds-list-row__title { color: var(--danger); }
+
+/* ── Divider ──────────────────────────────────────────────────────────── */
+.ds-divider {
+  height: 0;
+  border: none;
+  border-top: var(--border-width) solid var(--border-divider);
+  margin: 0;
+}
+
+.ds-divider-label {
+  display: flex;
+  align-items: center;
+  gap: var(--space-md);
+  color: var(--text-tertiary);
+  font-size: var(--text-caption-size);
+}
+.ds-divider-label::before,
+.ds-divider-label::after {
+  content: '';
+  flex: 1;
+  border-top: var(--border-width) solid var(--border-divider);
+}
+
+/* ── Empty state ──────────────────────────────────────────────────────────
