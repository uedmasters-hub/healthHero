@@ -0,0 +1,197 @@
+/* =============================================================================
+   Flow chrome — bottom CTA bars shared by booking, care and payment flows,
+   plus the care-journey status tones used on cards, history and relays.
+   ============================================================================= */
+
+/* —— App flow footer / primary CTA (booking + care flows) —— */
+.app-flow-footer {
+  flex-shrink: 0;
+  width: 100%;
+  background: var(--surface-chrome);
+  -webkit-backdrop-filter: blur(12px);
+  backdrop-filter: blur(12px);
+  border-top: var(--border-width) solid var(--border-default);
+  padding: var(--app-flow-footer-pad-top) var(--content-padding) var(--bottom-bar-pad);
+  z-index: 5;
+}
+
+/* The flow CTA *is* the large primary button — same tokens, same states */
+.app-flow-cta,
+.sticky-footer-cta__primary {
+  width: 100%;
+  min-height: var(--btn-height-lg);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-2);
+  padding: var(--btn-pad-lg);
+  border: none;
+  border-radius: var(--btn-radius);
+  background: var(--btn-primary-bg);
+  color: var(--btn-primary-fg);
+  font-family: inherit;
+  font-size: var(--btn-font-lg);
+  font-weight: var(--btn-weight);
+  letter-spacing: var(--letter-body);
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  transition: var(--interact-transition);
+}
+
+.app-flow-cta:hover:not(:disabled),
+.sticky-footer-cta__primary:hover:not(:disabled) {
+  background: var(--btn-primary-bg-hover);
+}
+
+.app-flow-cta:active:not(:disabled),
+.sticky-footer-cta__primary:active:not(:disabled) {
+  background: var(--btn-primary-bg-pressed);
+}
+
+.app-flow-cta:disabled,
+.sticky-footer-cta__primary:disabled {
+  background: var(--btn-disabled-bg);
+  color: var(--btn-disabled-fg);
+  opacity: 1;
+  cursor: not-allowed;
+}
+
+.app-flow-cta svg,
+.sticky-footer-cta__primary svg {
+  width: var(--icon-md);
+  height: var(--icon-md);
+  stroke-width: var(--icon-stroke);
+}
+
+/* Sticky footer CTA — Appointment Details, Ready for Visit (SSOT).
+   Bottom CTA owns the safe area; secondary floaters must stay above
+   (var(--fab-cta-gap)) and never use Home-style scroll FAB motion. */
+.sticky-footer-cta {
+  position: fixed;
+  bottom: 0;
+  left: 50%;
+  transform: translateX(-50%);
+  width: 100%;
+  max-width: var(--phone-width);
+  background: var(--surface-chrome);
+  -webkit-backdrop-filter: blur(12px);
+  backdrop-filter: blur(12px);
+  padding: var(--sticky-footer-pad-top) var(--content-padding) var(--sticky-footer-pad-bottom);
+  border-top: var(--border-width) solid var(--border-default);
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: var(--sticky-footer-cta-gap);
+  z-index: var(--z-footer);
+}
+
+.sticky-footer-cta.is-pending {
+  opacity: var(--opacity-soft);
+  pointer-events: none;
+}
+
+.sticky-footer-cta__secondary {
+  display: block;
+  width: 100%;
+  padding: var(--sticky-footer-secondary-pad-y) 0;
+  margin: 0;
+  background: none;
+  border: none;
+  color: var(--color-link);
+  font-size: var(--text-body-size);
+  line-height: var(--text-body-line);
+  font-weight: var(--font-weight-medium);
+  font-family: inherit;
+  cursor: pointer;
+  text-align: center;
+  transition: opacity var(--transition);
+}
+
+.sticky-footer-cta__secondary:active {
+  opacity: var(--opacity-strong);
+}
+
+/* —— Care-journey status tones ——
+   One tone map for Home relay cards, Treat history and relay chips.       */
+.upcoming-badge.is-upcoming,
+.upcoming-badge.is-visit,
+.treat-history-badge.is-upcoming,
+.treat-history-badge.is-visit,
+.relay-chip.is-upcoming,
+.relay-chip.is-visit {
+  background: var(--featured-glass);
+  color: var(--featured-ink);
+  border: var(--border-width) solid var(--featured-glass-border);
+}
+
+.upcoming-badge.is-checkin,
+.treat-history-badge.is-checkin,
+.relay-chip.is-checkin {
+  background: var(--badge-ready-bg);
+  color: var(--badge-ready-fg);
+  border: var(--border-width) solid var(--badge-ready-border);
+}
+
+.upcoming-badge.is-waiting,
+.upcoming-badge.is-missed,
+.treat-history-badge.is-waiting,
+.treat-history-badge.is-missed,
+.relay-chip.is-waiting,
+.relay-chip.is-missed {
+  background: var(--warning-500);
+  color: var(--warning-900);
+  border: var(--border-width) solid transparent;
+}
+
+.upcoming-badge.is-reported,
+.upcoming-badge.is-prescription,
+.upcoming-badge.is-confirmed,
+.treat-history-badge.is-reported,
+.treat-history-badge.is-prescription,
+.treat-history-badge.is-confirmed,
+.relay-chip.is-reported,
+.relay-chip.is-prescription,
+.relay-chip.is-confirmed {
+  background: var(--success-300);
+  color: var(--success-900);
+  border: var(--border-width) solid transparent;
+}
+
+.upcoming-badge.is-tests,
+.upcoming-badge.is-follow,
+.treat-history-badge.is-tests,
+.treat-history-badge.is-follow,
+.relay-chip.is-tests,
+.relay-chip.is-follow {
+  background: var(--secondary-500);
+  color: var(--secondary-900);
+  border: var(--border-width) solid transparent;
+}
+
+.upcoming-badge.is-referral,
+.treat-history-badge.is-referral,
+.relay-chip.is-referral {
+  background: var(--primary-300);
+  color: var(--primary-950);
+  border: var(--border-width) solid transparent;
+}
+
+.upcoming-badge.is-cancelled,
+.treat-history-badge.is-cancelled,
+.relay-chip.is-cancelled {
+  background: var(--neutral-200);
+  color: var(--neutral-700);
+  border: var(--border-width) solid transparent;
+}
+
+.relay-chip {
+  display: inline-flex;
+  align-items: center;
+  margin-top: var(--space-1-5);
+  min-height: var(--badge-height);
+  padding: 0 var(--badge-pad-x);
+  border-radius: var(--radius-full);
+  font-size: var(--badge-font);
+  font-weight: var(--font-weight-medium);
+  letter-spacing: var(--letter-body);
+}
diff --git a/src/styles/motion.css b/src/styles/motion.css
new file mode 100644
index 0000000..e73be9f
--- /dev/null
+++ b/src/styles/motion.css
@@ -0,0 +1,191 @@
+/* =============================================================================
+   Motion — the shared vocabulary. PocketPills:
+   200ms interaction · 300–380ms reveal / chrome slide · 500ms+ progress ·
+   routed content enters with fade-up (cubic-bezier(0.16,1,0.3,1)) ·
+   reduced motion disables sheen, chrome slides and reveals.
+
+   Keyframes are global — define each name exactly once, here.
+   ============================================================================= */
+
+@keyframes fadeIn {
+  from { opacity: 0; }
+  to { opacity: 1; }
+}
+
+@keyframes fadeOut {
+  from { opacity: 1; }
+  to { opacity: 0; }
+}
+
+/* PP `animate-fade-up` */
+@keyframes fadeUp {
+  from { opacity: 0; transform: translateY(8px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+/* Soft enter for toasts / banners */
+@keyframes slideUp {
+  from { transform: translateY(20px); opacity: 0; }
+  to { transform: translateY(0); opacity: 1; }
+}
+
+/* Bottom sheets / drawers */
+@keyframes sheetUp {
+  from { transform: translateY(100%); }
+  to { transform: translateY(0); }
+}
+
+@keyframes popIn {
+  from { transform: scale(0.8); opacity: 0; }
+  to { transform: scale(1); opacity: 1; }
+}
+
+@keyframes ds-spin {
+  to { transform: rotate(360deg); }
+}
+
+/* PP `pp-sheen` — travels right → left across a lavender base */
+@keyframes shimmer {
+  0% { background-position: 200% 0; }
+  100% { background-position: -200% 0; }
+}
+
+@keyframes ds-skel-in {
+  from { opacity: 0; }
+  to { opacity: 1; }
+}
+
+@keyframes ds-pulse {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.45; }
+}
+
+/* ── Enter helpers ────────────────────────────────────────────────────── */
+.ds-enter {
+  animation: fadeUp var(--duration-enter) var(--ease-enter) both;
+}
+
+.ds-fade-in {
+  animation: fadeIn var(--duration-reveal) var(--ease-standard) both;
+}
+
+.ds-spinner {
+  display: inline-block;
+  width: 1.125rem;
+  height: 1.125rem;
+  border-radius: var(--radius-full);
+  border: 2px solid currentColor;
+  border-right-color: transparent;
+  animation: ds-spin 0.7s linear infinite;
+}
+
+/* ── Skeleton ─────────────────────────────────────────────────────────────
+   PP `.pp-skeleton`: lavender base + white sheen, 1.55s. `.shimmer` is the
+   legacy name used by every screen skeleton — same look.                   */
+.shimmer,
+.ds-skel {
+  background-color: var(--skel-base);
+  background-image: linear-gradient(
+    105deg,
+    transparent 0%,
+    var(--skel-sheen) 42%,
+    transparent 78%
+  );
+  background-size: 220% 100%;
+  animation: shimmer var(--duration-sheen) var(--ease-standard) infinite;
+}
+
+.ds-skel {
+  display: block;
+  border-radius: var(--radius-md);
+}
+
+.ds-skel.is-text { height: 0.75rem; border-radius: var(--radius-full); }
+.ds-skel.is-title { height: 1rem; width: 60%; border-radius: var(--radius-full); }
+.ds-skel.is-circle { border-radius: var(--radius-full); aspect-ratio: 1; }
+.ds-skel.is-pill { border-radius: var(--radius-full); }
+.ds-skel.is-card { border-radius: var(--card-radius); }
+.ds-skel.is-btn { height: var(--btn-height-md); border-radius: var(--radius-full); }
+
+.ds-skel-in {
+  animation: ds-skel-in var(--duration-reveal) var(--ease-emphasized) both;
+}
+
+.end-of-page-placeholder {
+  text-align: center;
+  font-size: var(--text-caption-size);
+  color: var(--text-tertiary);
+  padding: var(--space-10) 0 var(--space-12);
+  letter-spacing: var(--letter-body);
+}
+
+/* ── Reveal host — skeleton cross-fades into content ─────────────────── */
+.reveal-host {
+  position: relative;
+  overflow: hidden;
+}
+
+.reveal-host > .reveal-body {
+  width: 100%;
+}
+
+.reveal-skel {
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  pointer-events: none;
+  opacity: 1;
+  transition: opacity var(--duration-moderate) var(--ease-standard);
+}
+
+.reveal-skel.is-hidden {
+  opacity: 0;
+}
+
+.reveal-skel-fill {
+  width: 100%;
+  height: 100%;
+  border-radius: inherit;
+}
+
+.reveal-host > .reveal-skel-fill,
+.reveal-skel .reveal-skel-fill {
+  border-radius: inherit;
+}
+
+.reveal-body {
+  opacity: 0;
+  transform: translateY(8px);
+  transition: var(--transition-reveal);
+}
+
+.reveal-body.is-visible {
+  opacity: 1;
+  transform: none;
+}
+
+.reveal-host.is-cached .reveal-skel {
+  display: none;
+}
+
+.reveal-host.is-cached .reveal-body {
+  opacity: 1;
+  transform: none;
+  transition: none;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .shimmer,
+  .ds-skel,
+  .ds-enter,
+  .ds-fade-in,
+  .ds-skel-in {
+    animation: none;
+  }
+
+  .reveal-body {
+    opacity: 1;
+    transform: none;
+    transition: none;
+  }
+}
diff --git a/src/styles/primitives.css b/src/styles/primitives.css
new file mode 100644
index 0000000..ab70d0d
--- /dev/null
+++ b/src/styles/primitives.css
@@ -0,0 +1,1022 @@
+/* =============================================================================
+   Primitives — the only place component *appearance* is defined.
+   Screen stylesheets may position these (margin, grid placement, width) but must
+   not restate their colour, radius, type, border, shadow or motion.
+
+   Mirrors PocketPills: Button (`.ds-btn-*`), Card, Badge, Field, Toggle chip,
+   SectionHead, Skeleton, AppShell nav states.
+   ============================================================================= */
+
+/* ── Button ────────────────────────────────────────────────────────────────
+   <button class="ds-btn ds-btn--primary ds-btn--md">
+   variants: primary · secondary · ghost · outline · text · danger · wellness
+   sizes:    lg (flow CTA 56) · md (46, default) · sm (36, inline)            */
+.ds-btn {
+  --_h: var(--btn-height-md);
+  --_pad: var(--btn-pad-md);
+  --_fs: var(--btn-font-md);
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-sm);
+  min-height: var(--_h);
+  padding: var(--_pad);
+  border: var(--border-width) solid transparent;
+  border-radius: var(--btn-radius);
+  background: var(--btn-primary-bg);
+  color: var(--btn-primary-fg);
+  font-family: inherit;
+  font-size: var(--_fs);
+  font-weight: var(--btn-weight);
+  line-height: 1.2;
+  letter-spacing: var(--letter-body);
+  text-align: center;
+  text-decoration: none;
+  white-space: nowrap;
+  cursor: pointer;
+  user-select: none;
+  -webkit-tap-highlight-color: transparent;
+  transition: var(--interact-transition);
+}
+
+.ds-btn svg {
+  width: var(--icon-md);
+  height: var(--icon-md);
+  flex-shrink: 0;
+  stroke-width: var(--icon-stroke);
+}
+
+.ds-btn--lg { --_h: var(--btn-height-lg); --_pad: var(--btn-pad-lg); --_fs: var(--btn-font-lg); }
+.ds-btn--md { --_h: var(--btn-height-md); --_pad: var(--btn-pad-md); --_fs: var(--btn-font-md); }
+.ds-btn--sm { --_h: var(--btn-height-sm); --_pad: var(--btn-pad-sm); --_fs: var(--btn-font-sm); }
+.ds-btn--sm svg { width: var(--icon-sm); height: var(--icon-sm); }
+.ds-btn--block { display: flex; width: 100%; }
+.ds-btn--icon { --_pad: 0; width: var(--_h); }
+
+/* Small buttons keep a 44px hit area without growing their chrome */
+.ds-btn--sm::after {
+  content: '';
+  position: absolute;
+  inset: calc((var(--touch-min) - var(--btn-height-sm)) / -2) 0;
+}
+
+/* primary — neutral-800 → hover neutral-600 */
+.ds-btn--primary { background: var(--btn-primary-bg); color: var(--btn-primary-fg); }
+.ds-btn--primary:hover:not(:disabled):not([aria-disabled='true']) { background: var(--btn-primary-bg-hover); }
+.ds-btn--primary:active:not(:disabled):not([aria-disabled='true']) { background: var(--btn-primary-bg-pressed); }
+
+/* secondary — white + hairline, inverts when pressed */
+.ds-btn--secondary {
+  background: var(--btn-secondary-bg);
+  color: var(--btn-secondary-fg);
+  border-color: var(--btn-secondary-border);
+  box-shadow: var(--shadow-btn);
+}
+.ds-btn--secondary:hover:not(:disabled):not([aria-disabled='true']) { background: var(--state-hover); box-shadow: none; }
+.ds-btn--secondary:active:not(:disabled):not([aria-disabled='true']) {
+  background: var(--btn-invert-bg);
+  border-color: var(--btn-invert-bg);
+  color: var(--neutral-0);
+  box-shadow: none;
+}
+
+/* ghost — quiet lavender fill */
+.ds-btn--ghost { background: var(--btn-quiet-bg); color: var(--neutral-900); }
+.ds-btn--ghost:hover:not(:disabled):not([aria-disabled='true']) { background: var(--btn-quiet-bg-hover); }
+.ds-btn--ghost:active:not(:disabled):not([aria-disabled='true']) { background: var(--btn-invert-bg); color: var(--neutral-0); }
+
+/* outline — ink border */
+.ds-btn--outline { background: transparent; color: var(--neutral-800); border-color: var(--neutral-800); }
+.ds-btn--outline:hover:not(:disabled):not([aria-disabled='true']) { background: var(--neutral-100); }
+.ds-btn--outline:active:not(:disabled):not([aria-disabled='true']) { background: var(--neutral-800); color: var(--neutral-0); }
+
+/* text — inline action, brand ink */
+.ds-btn--text {
+  --_pad: 0 var(--space-xs);
+  background: transparent;
+  color: var(--color-link);
+  border-color: transparent;
+}
+.ds-btn--text:hover:not(:disabled):not([aria-disabled='true']) { text-decoration: underline; text-underline-offset: 3px; }
+.ds-btn--text:active:not(:disabled):not([aria-disabled='true']) { opacity: var(--opacity-strong); }
+
+/* danger — destructive confirm */
+.ds-btn--danger { background: var(--color-danger); color: var(--neutral-0); }
+.ds-btn--danger:hover:not(:disabled):not([aria-disabled='true']) { background: color-mix(in srgb, var(--color-danger) 86%, var(--neutral-900)); }
+.ds-btn--danger-quiet { background: var(--color-danger-subtle); color: var(--color-danger); }
+.ds-btn--danger-quiet:hover:not(:disabled):not([aria-disabled='true']) { background: color-mix(in srgb, var(--color-danger-subtle) 70%, var(--error-700)); }
+.ds-btn--text.is-danger { color: var(--color-danger); }
+
+/* wellness — teal confirm (success moments) */
+.ds-btn--wellness { background: var(--color-wellness); color: var(--neutral-0); }
+.ds-btn--wellness:hover:not(:disabled):not([aria-disabled='true']) { opacity: var(--opacity-pressed); }
+
+/* on-media — glass button over the featured gradient / photos */
+.ds-btn--glass {
+  background: var(--featured-glass);
+  color: var(--featured-ink);
+  border-color: var(--featured-glass-border);
+}
+.ds-btn--glass:hover:not(:disabled) { background: color-mix(in srgb, var(--neutral-0) 26%, transparent); }
+.ds-btn--inverse { background: var(--neutral-0); color: var(--neutral-800); }
+.ds-btn--inverse:hover:not(:disabled) { background: var(--primary-200); }
+
+.ds-btn:disabled,
+.ds-btn[aria-disabled='true'] {
+  cursor: not-allowed;
+  box-shadow: none;
+}
+.ds-btn--primary:disabled,
+.ds-btn--primary[aria-disabled='true'],
+.ds-btn--danger:disabled,
+.ds-btn--wellness:disabled,
+.ds-btn--secondary:disabled,
+.ds-btn--ghost:disabled {
+  background: var(--btn-disabled-bg);
+  border-color: transparent;
+  color: var(--btn-disabled-fg);
+  opacity: 1;
+}
+.ds-btn--outline:disabled { border-color: var(--neutral-300); color: var(--btn-disabled-fg); }
+.ds-btn--text:disabled { color: var(--text-disabled); }
+
+/* Busy — label stays for width; spinner overlays */
+.ds-btn.is-loading { color: transparent !important; pointer-events: none; }
+.ds-btn.is-loading::before {
+  content: '';
+  position: absolute;
+  width: 1.125rem;
+  height: 1.125rem;
+  border-radius: var(--radius-full);
+  border: 2px solid var(--btn-primary-fg);
+  border-right-color: transparent;
+  animation: ds-spin 0.7s linear infinite;
+}
+.ds-btn--secondary.is-loading::before,
+.ds-btn--ghost.is-loading::before,
+.ds-btn--outline.is-loading::before,
+.ds-btn--text.is-loading::before { border-color: var(--neutral-800); border-right-color: transparent; }
+
+.ds-btn-row {
+  display: flex;
+  gap: var(--space-sm);
+  align-items: center;
+}
+.ds-btn-row > .ds-btn { flex: 1 1 0; min-width: 0; }
+.ds-btn-stack {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-sm);
+}
+
+/* ── Icon button & wells ──────────────────────────────────────────────── */
+.ds-icon-btn {
+  width: var(--icon-btn-size);
+  height: var(--icon-btn-size);
+  min-width: var(--icon-btn-size);
+  min-height: var(--icon-btn-size);
+  border-radius: var(--icon-btn-radius);
+  border: none;
+  background: var(--icon-surface-ghost);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  color: var(--icon-color-default);
+  padding: 0;
+  flex-shrink: 0;
+  font: inherit;
+  text-decoration: none;
+  -webkit-tap-highlight-color: transparent;
+  transition: var(--interact-transition);
+}
+
+.ds-icon-btn svg,
+.ds-icon {
+  width: var(--icon-lg);
+  height: var(--icon-lg);
+  flex-shrink: 0;
+  stroke-width: var(--icon-stroke);
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.ds-icon.is-xs,
+.ds-icon-btn.is-xs svg { width: var(--icon-xs); height: var(--icon-xs); }
+.ds-icon.is-sm,
+.ds-icon-btn.is-sm svg { width: var(--icon-sm); height: var(--icon-sm); }
+.ds-icon.is-md,
+.ds-icon-btn.is-md svg { width: var(--icon-md); height: var(--icon-md); }
+.ds-icon.is-lg,
+.ds-icon-btn.is-lg svg { width: var(--icon-lg); height: var(--icon-lg); }
+.ds-icon.is-xl,
+.ds-icon-btn.is-xl svg { width: var(--icon-xl); height: var(--icon-xl); }
+.ds-icon.is-2xl,
+.ds-icon-btn.is-2xl svg { width: var(--icon-2xl); height: var(--icon-2xl); }
+
+.ds-icon-btn.is-muted { color: var(--icon-color-muted); }
+.ds-icon-btn.is-ink { color: var(--pp-headline); }
+
+/* Bordered — Share, Favorite, filters, header avatar-sized controls */
+.ds-icon-btn.is-subtle {
+  border: var(--icon-btn-border);
+  background: var(--icon-surface-subtle);
+  color: var(--icon-color-default);
+}
+.ds-icon-btn.is-subtle svg { width: var(--icon-md); height: var(--icon-md); }
+
+/* Filled — CTA-coloured round action (FAB, call) */
+.ds-icon-btn.is-filled {
+  background: var(--btn-primary-bg);
+  color: var(--btn-primary-fg);
+}
+.ds-icon-btn.is-filled:hover:not(:disabled) { background: var(--btn-primary-bg-hover); }
+
+.ds-icon-btn.is-sm-size {
+  width: var(--btn-height-sm);
+  height: var(--btn-height-sm);
+  min-width: var(--btn-height-sm);
+  min-height: var(--btn-height-sm);
+}
+
+.ds-icon-btn:hover:not(:disabled):not(.is-filled) { background: var(--state-hover); }
+.ds-icon-btn.is-subtle:hover:not(:disabled) { background: var(--state-hover); }
+.ds-icon-btn:active:not(:disabled):not(.is-filled) { background: var(--state-pressed); }
+.ds-icon-btn.is-filled:active:not(:disabled) { background: var(--btn-primary-bg-pressed); }
+
+.ds-icon-btn:disabled,
+.ds-icon-btn.is-disabled {
+  opacity: var(--opacity-disabled);
+  cursor: not-allowed;
+}
+
+.ds-icon-btn.is-selected,
+.ds-icon-btn[aria-pressed='true'] {
+  background: var(--interact-selected-bg);
+  color: var(--icon-color-brand);
+  border-color: var(--interact-selected-border);
+}
+
+.ds-icon-btn.is-brand {
+  color: var(--icon-color-brand);
+  background: var(--icon-surface-brand);
+}
+
+.ds-icon-btn.is-danger,
+.ds-icon-btn.is-error { color: var(--icon-color-danger); }
+.ds-icon-btn.is-danger.is-subtle,
+.ds-icon-btn.is-error.is-subtle {
+  background: var(--icon-surface-danger);
+  border-color: var(--danger-bg);
+}
+.ds-icon-btn.is-success { color: var(--icon-color-success); }
+.ds-icon-btn.is-warning { color: var(--icon-color-warning); }
+
+/* Soft circular wells (info cells, quick actions) */
+.ds-icon-well {
+  width: var(--icon-well-size);
+  height: var(--icon-well-size);
+  border-radius: var(--icon-btn-radius);
+  border: none;
+  background: var(--icon-surface-brand);
+  color: var(--icon-color-brand);
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+
+/* PP icon tile — 16px-radius square (feature tiles, list leading icons) */
+.ds-icon-well.is-tile { border-radius: var(--icon-tile-radius); }
+
+.ds-icon-well svg {
+  width: var(--icon-sm);
+  height: var(--icon-sm);
+  stroke-width: var(--icon-stroke);
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.ds-icon-well.is-lg {
+  width: var(--icon-well-size-lg);
+  height: var(--icon-well-size-lg);
+}
+.ds-icon-well.is-lg svg { width: var(--icon-lg); height: var(--icon-lg); }
+.ds-icon-well.is-info { background: var(--icon-surface-info); color: var(--icon-color-info); }
+.ds-icon-well.is-success { background: var(--icon-surface-success); color: var(--icon-color-success); }
+.ds-icon-well.is-warning { background: var(--icon-surface-warning); color: var(--icon-color-warning); }
+.ds-icon-well.is-danger,
+.ds-icon-well.is-error { background: var(--icon-surface-danger); color: var(--icon-color-danger); }
+.ds-icon-well.is-muted { background: var(--icon-surface-muted); color: var(--icon-color-muted); }
+.ds-icon-well.is-plain { background: transparent; color: var(--icon-color-default); }
+
+/* ── Card ──────────────────────────────────────────────────────────────────
+   PP: rounded-2xl · hairline edge · white · no shadow.
+   .is-interactive → state tint only (no lift / scale / glow).             */
+.ds-card {
+  background: var(--card-bg);
+  border: var(--card-border);
+  border-radius: var(--card-radius);
+  box-shadow: none;
+}
+
+.ds-card.is-padded { padding: var(--card-padding); }
+.ds-card.is-padded-lg { padding: var(--card-padding-lg); }
+.ds-card.is-compact { border-radius: var(--card-radius-sm); }
+.ds-card.is-muted { background: var(--surface-1); }
+.ds-card.is-tinted { background: var(--primary-300); border-color: transparent; }
+.ds-card.is-clip { overflow: hidden; }
+
+.ds-card.is-elevated,
+.ds-card-elevated { box-shadow: var(--shadow-card); }
+
+.ds-card-flat {
+  background: var(--card-bg);
+  border: var(--card-border);
+  border-radius: var(--card-radius-sm);
+  box-shadow: none;
+}
+
+.ds-card.is-interactive {
+  width: 100%;
+  font: inherit;
+  color: inherit;
+  text-align: left;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  transition: var(--interact-transition);
+}
+.ds-card.is-interactive:hover:not(:disabled):not(.is-selected) { background: var(--state-hover); }
+.ds-card.is-interactive:active:not(:disabled) { background: var(--state-pressed); }
+.ds-card.is-selected,
+.ds-card[aria-pressed='true'],
+.ds-card[aria-checked='true'] {
+  background: var(--state-selected);
+  border-color: var(--state-selected-border);
+}
+
+.ds-card__title {
+  font-size: var(--text-title-size);
+  line-height: var(--text-title-line);
+  font-weight: var(--font-weight-medium);
+  color: var(--text-primary);
+}
+
+.ds-card__meta {
+  font-size: var(--text-caption-size);
+  line-height: var(--text-caption-line);
+  color: var(--text-tertiary);
+}
+
+/*
+  Interactive surface language (legacy names — same behaviour as Card).
+  Hover = tint · pressed = deeper tint · selected = lavender + ink edge.
+*/
+.ds-interact {
+  border: var(--border-width) solid var(--border);
+  background: var(--card-bg);
+  box-shadow: none;
+  transition: var(--interact-transition);
+}
+
+.ds-interact:hover:not(:disabled):not([aria-disabled='true']):not(.is-selected):not(.is-active):not([aria-selected='true']):not([aria-pressed='true']) {
+  background: var(--interact-hover-bg);
+  border-color: var(--interact-hover-border);
+}
+
+.ds-interact:active:not(:disabled):not([aria-disabled='true']) {
+  background: var(--interact-pressed-bg);
+  border-color: var(--interact-pressed-border);
+}
+
+.ds-interact.is-selected,
+.ds-interact.is-active,
+.ds-interact[aria-selected='true'],
+.ds-interact[aria-pressed='true'] {
+  background: var(--interact-selected-bg);
+  border-color: var(--interact-selected-border);
+  box-shadow: none;
+}
+
+/* Borderless rows (sheet options, nav rows) — tint only */
+.ds-interact-row {
+  background: transparent;
+  border: none;
+  box-shadow: none;
+  transition: var(--interact-transition);
+}
+
+.ds-interact-row:hover:not(:disabled):not([aria-disabled='true']):not(.is-selected):not(.is-active):not([aria-selected='true']):not(.active) {
+  background: var(--interact-hover-bg);
