+/* =============================================================================
+   eMedicalls design tokens — PocketPills production language (source of truth)
+
+   Architecture:  primitive  →  semantic role  →  component token / legacy alias
+   Rules
+   - Components consume semantic roles (--surface-*, --text-*, --border-*,
+     --color-*) or component tokens (--btn-*, --chip-*, --card-*). Never a hex.
+   - Legacy eMedicalls names (--primary, --white, --cta …) stay as aliases so
+     older selectors keep resolving; new work should not reach for them.
+   - Mirrors pocketpills/src/index.css + tailwind.config.js + DESIGN.md.
+   ============================================================================= */
+
+:root {
+  /* ── 1. Primitives (PocketPills production) ─────────────────────────────── */
+  --primary-950: #4e2a84;
+  --primary-900: #220f3e;
+  --primary-800: #37325d;
+  --primary-700: #6b1ce2;
+  --primary-600: #7b47ff;
+  --primary-500: #8c60ff;
+  --primary-400: #aaa4ff;
+  --primary-300: #e5e3ff;
+  --primary-200: #f5f4fa;
+  --primary-100: #ffffff;
+
+  --neutral-900: #180730;
+  --neutral-800: #362952;
+  --neutral-700: #534b74;
+  --neutral-600: #67648b;
+  --neutral-500: #8e90b8;
+  --neutral-400: #aaacca;
+  --neutral-300: #c8c8dc;
+  --neutral-200: #e7e7f2;
+  --neutral-100: #f5f4fa;
+  --neutral-50: #fafafa;
+  --neutral-0: #ffffff;
+
+  --secondary-900: #043b45;
+  --secondary-800: #0a5a68;
+  --secondary-700: #54c7da;
+  --secondary-600: #a4eefb;
