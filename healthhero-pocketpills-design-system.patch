+  --text-label-weight: var(--font-weight-medium);
+
+  --text-caption-size: var(--font-size-body-xxs);
+  --text-caption-line: 1.5;
+  --text-caption-weight: var(--font-weight-medium);
+
+  --text-overline-size: 0.8125rem;
+  --text-overline-line: 1.35;
+  --text-overline-weight: var(--font-weight-bold);
+  --text-overline-tracking: 0.04em;
+
+  --text-subtitle-size: var(--font-size-body-m);
+  --text-subtitle-line: 1.2;
+  --text-subtitle-weight: var(--font-weight-medium);
+
+  --text-micro-size: var(--font-size-floor);
+  --text-micro-line: 1.3;
+
+  --text-lead-size: var(--font-size-body-l);
+  --text-hero-size: var(--font-size-h4);
+  --text-stat-size: var(--font-size-h2);
+  --text-badge-size: var(--font-size-floor);
+
+  --letter-tight: 0;
+  --letter-snug: 0;
+  --letter-body: 0.02em;
+  --letter-caps: 0.04em;
+
+  /* Opacity */
+  --opacity-disabled: 0.45;
+  --opacity-muted: 0.7;
+  --opacity-soft: 0.5;
+  --opacity-pressed: 0.9;
+  --opacity-strong: 0.8;
+  --opacity-ghost: 0.3;
+  --opacity-hidden: 0;
+  --opacity-visible: 1;
+
+  /* Motion — PP: 200ms interaction · 300–380ms reveal / chrome · 500ms+ progress */
+  --ease-standard: ease-in-out;
+  --ease-out: ease-out;
+  --ease-emphasized: cubic-bezier(0.22, 1, 0.36, 1);
+  --ease-enter: cubic-bezier(0.16, 1, 0.3, 1);
+  --ease-sheet: cubic-bezier(0.32, 0.72, 0, 1);
+  --ease-page: cubic-bezier(0.32, 0.72, 0, 1);
+  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
+  --duration-instant: 0.12s;
+  --duration-fast: 0.15s;
+  --duration-normal: 0.2s;
+  --duration-dialog: 0.22s;
+  --duration-sheet: 0.26s;
+  --duration-moderate: 0.28s;
+  --duration-page: 0.28s;
+  --duration-reveal: 0.38s;
+  --duration-slow: 0.4s;
+  --duration-enter: 0.5s;
+  --duration-progress: 0.5s;
+  --duration-sheen: 1.55s;
+  --sheet-recess-scale: 0.98;
+  --sheet-recess-shift: -6px;
+  --transition: var(--duration-normal) var(--ease-standard);
+  --transition-reveal: opacity var(--duration-moderate) var(--ease-standard),
+    transform var(--duration-reveal) var(--ease-emphasized);
+
+  /* Layout / Frame */
+  --phone-width: 440px;
+  --phone-height: 956px;
+  --phone-scale: 1;
+  --frame-footer: 28px;
+  --safe-bottom: env(safe-area-inset-bottom, 0px);
+  --bottom-bar-pad: calc(var(--space-2-5) + max(var(--frame-footer), var(--safe-bottom)));
+  --app-flow-footer-pad-top: var(--space-3-5);
+  --app-flow-footer-clearance: calc(
+    var(--app-flow-footer-pad-top)
+    + var(--app-flow-cta-height)
+    + var(--bottom-bar-pad)
+  );
+  --fab-cta-gap: 22px;
+  --sticky-footer-pad-top: var(--space-2-5);
+  --sticky-footer-cta-gap: var(--space-1);
+  --sticky-footer-secondary-pad-y: var(--space-1-5);
+  --sticky-footer-pad-bottom: calc(var(--space-1-5) + max(var(--frame-footer), var(--safe-bottom)));
+  --sticky-footer-clearance: calc(
+    var(--sticky-footer-pad-top)
+    + var(--app-flow-cta-height)
+    + var(--sticky-footer-cta-gap)
+    + (var(--sticky-footer-secondary-pad-y) * 2)
+    + (var(--text-body-size) * var(--text-body-line))
+    + var(--sticky-footer-pad-bottom)
+  );
+  --app-sheet-max-height: 85%;
+  --app-sheet-radius: var(--radius-pp-l);
+  --sheet-surface: var(--surface-2);
+  --sheet-pad-x: var(--space-5);
+  --sheet-pad-top: var(--space-2);
+  --sheet-pad-bottom: var(--bottom-bar-pad);
+  --sheet-handle-width: 40px;
+  --sheet-handle-height: 4px;
+  --z-header: 50;
+  --z-footer: 100;
+  --z-overlay: 1000;
+  --z-sheet: 1001;
+  --z-status: 20;
+  --z-home-indicator: 25;
+  --z-scrim: 8000;
+  --z-scrim-elevated: 8100;
+  --z-lightbox: 8200;
+}
